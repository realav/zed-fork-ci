+    /// The tab's title, honouring a custom (renamed) title first, then the
+    /// `terminal.tab_title` setting, then the terminal's own title.
+    fn tab_title(&self, truncate: bool, cx: &App) -> SharedString {
+        if let Some(custom_title) = self.custom_title.as_ref().filter(|t| !t.trim().is_empty()) {
+            return custom_title.clone().into();
+        }
+        let terminal = self.terminal().read(cx);
+        if TerminalSettings::get_global(cx).tab_title == TerminalTabTitle::ShellTitle {
+            let shell_title = terminal.breadcrumb_text.trim();
+            if !shell_title.is_empty() {
+                return if truncate {
+                    truncate_and_trailoff(shell_title, MAX_TAB_TITLE_CHARS)
+                } else {
+                    shell_title.to_string()
+                }
+                .into();
+            }
+        }
+        terminal.title(truncate).into()
+    }
